@{
    ViewData["Title"] = "Dashboard";
}

<h3>Dashboard</h3>

<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Employees</h5>
                <p class="card-text fs-3">@ViewBag.TotalEmployees</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Active Employees</h5>
                <p class="card-text fs-3">@ViewBag.ActiveEmployees</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Inactive Employees</h5>
                <p class="card-text fs-3">@ViewBag.InactiveEmployees</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Present Today</h5>
                <p class="card-text fs-3">@ViewBag.PresentToday</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">Absent Today</h5>
                <p class="card-text fs-3">@ViewBag.AbsentToday</p>
            </div>
        </div>
    </div>
</div>